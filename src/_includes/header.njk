<header id="header" class="header sticky-top">
  <div class="topbar d-flex align-items-center">
    <div class="container d-flex justify-content-center justify-content-md-start">
      <div class="contact-info d-flex align-items-center">
        <i class="bi bi-envelope d-flex align-items-center">
          <a href="mailto:{{ site.email }}">{{ site.email }}</a>
        </i>
      </div>
    </div>
  </div>
  <div class="branding d-flex align-items-center">
    <div class="container position-relative d-flex align-items-center justify-content-between">
      <a href="index.html" class="logo d-flex flex-column align-items-start me-auto">
        <h1 class="sitename mb-0">{{ site.name }}</h1>
        <span class="lab-subtitle">{{ site.subtitle }}</span>
      </a>
      <nav id="navmenu" class="navmenu">
        <ul>
          {% for item in site.navigation %}
          {% if item.children %}
          {% set groupActive = false %}
          {% for child in item.children %}
            {% if child.href == page.activeHref %}{% set groupActive = true %}{% endif %}
          {% endfor %}
          <li class="dropdown">
            <a href="#"{% if groupActive %} class="active"{% endif %}>
              <span>{{ item.label }}</span>
              <i class="bi bi-chevron-down toggle-dropdown"></i>
            </a>
            <ul>
              {% for child in item.children %}
              <li><a href="{{ child.href }}"{% if child.href == page.activeHref %} class="active"{% endif %}{% if child.href == page.filename %} aria-current="page"{% endif %}>{{ child.label }}</a></li>
              {% endfor %}
            </ul>
          </li>
          {% else %}
          <li><a href="{{ item.href }}"{% if item.href == page.activeHref %} class="active" aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {% endif %}
          {% endfor %}
        </ul>
        <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
      </nav>
      <a class="cta-btn d-none d-sm-block" href="{{ page.contactHref }}">Contact us</a>
    </div>
  </div>
</header>
