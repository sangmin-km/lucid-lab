{% extends "_includes/base.njk" %}
{% set fontStylesheet = "https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Poppins:wght@300;400;500;600;700;800&family=Raleway:wght@300;400;500;600;700;800&display=swap" %}
{% block htmlOpen %}<html lang="ko">{% endblock %}
{% block head %}
<title>Members | LUCID</title>
