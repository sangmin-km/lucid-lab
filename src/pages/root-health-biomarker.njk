      <td class="num">15,149</td>
    </tr>
<tr>
      <td class="marker-name">ROS1</td>
      <td>NGS, PCR, IHC, FISH</td>
      <td class="num">8,477</td>
      <td class="num">22.2%</td>
      <td class="num">10,239</td>
    </tr>
<tr>
      <td class="marker-name">NTRK</td>
      <td>NGS, IHC</td>
      <td class="num">5,111</td>
