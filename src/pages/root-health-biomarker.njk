{% extends "_includes/base.njk" %}
{% block htmlOpen %}<html lang="en">{% endblock %}
{% block head %}
<title>Genomic & Biomarker Data | ROOT HEALTH</title>
{% endblock %}
{% block styles %}
<link href="assets/css/pages/root-health-biomarker.css" rel="stylesheet">
{% endblock %}
{% block bodyOpen %}<body>{% endblock %}
{% block content %}
<main class="main">

  <section class="biomarker-page">

    <div class="container">

      <div class="breadcrumb-line">
        <a href="data.html">Data</a>
        <span class="mx-2">/</span>
        Genomic &amp; Biomarker Data
      </div>

      <h1 class="page-title">GENOMIC &amp; BIOMARKER DATA</h1>

      <p class="page-subtitle">
        ROOT HEALTH includes molecular and biomarker testing data for major
        actionable and clinically relevant biomarkers in NSCLC.
        The table below preserves the testing modalities, patient coverage,
        and total test volumes summarized in the current ROOT HEALTH workbook.
      </p>

      <div class="cohort-note">
        <strong>Cohort definition:</strong>
        38,154 patients with NSCLC, excluding stage 0, who received cancer-directed
        treatment at Samsung Medical Center.
        <strong>Data cutoff:</strong> September 18, 2026.
      </div>

      <div class="table-panel" data-aos="fade-up">

        <div class="table-head">
          <h2>Genomic and Biomarker Data Available in ROOT HEALTH</h2>
          <p>
            Patient-level testing coverage and total number of tests performed.
          </p>
        </div>

        <div class="table-responsive">

          <table class="bio-table">

            <thead>
              <tr>
                <th>Biomarker</th>
                <th>Testing Modalities</th>
                <th class="num">Patients Tested (N)</th>
                <th class="num">Patients Tested (%)</th>
                <th class="num">Tests Performed (N)</th>
              </tr>
            </thead>

            <tbody>
              <tr>
      <td class="marker-name">EGFR</td>
      <td>NGS, PCR, PCR-based sequencing</td>
      <td class="num">31,667</td>
      <td class="num">83.0%</td>
      <td class="num">70,617</td>
    </tr>
<tr>
      <td class="marker-name">ALK</td>
