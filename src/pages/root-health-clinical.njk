{% extends "_includes/base.njk" %}
{% block htmlOpen %}<html lang="en">{% endblock %}
{% block head %}
<title>Clinical Variables | ROOT HEALTH</title>
{% endblock %}
{% block styles %}
<link href="assets/css/pages/root-health-clinical.css" rel="stylesheet">
{% endblock %}
{% block bodyOpen %}<body>{% endblock %}
{% block content %}
<main class="main">
  <section class="clinical-page">
    <div class="container">

      <div class="breadcrumb-line">
        <a href="data.html">Data</a>
        <span class="mx-2">/</span>
        Clinical Variables
      </div>

      <h1 class="page-title">CLINICAL VARIABLES</h1>

      <p class="page-subtitle">
        ROOT HEALTH includes comprehensive longitudinal clinical data
        covering patient characteristics, diagnosis, treatment,
        molecular testing, follow-up, and clinical outcomes.
      </p>

      <div class="table-panel">
        <div class="table-head">
          <h2>Clinical Variables Available in ROOT HEALTH</h2>
          <p>38 summarized variable groups across 7 clinical domains.</p>
        </div>

        <div class="table-responsive">
          <table class="clinical-table">
            <thead>
              <tr>
                <th>Clinical Domain</th>
                <th>Summarized Subcategory</th>
                <th>Data Description</th>
                <th>Data Included / Coverage</th>
                <th>Data Value (Examples)</th>
              </tr>
            </thead>
            <tbody>
              <tr>
      <td><span class="domain-badge">Registry / Common</span></td>
      <td class="subcategory">Cancer registry identifiers</td>
      <td>Registry source and identifiers used to define each cancer case in ROOT HEALTH.</td>
      <td>Includes whether the case is linked to cancer registration data, cancer registration year/month, registration serial number, and cohort application date. Registration year refers to the year recorded through Korea&#x27;s national cancer registration framework (Korea Central Cancer Registry, KCCR).</td>
      <td class="examples">Source: registered / non-registered; Year: YYYY; Month: MM; Serial no.; Date: YYYY-MM-DD</td>
    </tr>
<tr>
      <td><span class="domain-badge">Basic Information</span></td>
      <td class="subcategory">Patient demographics</td>
      <td>Core demographic characteristics.</td>
      <td>Date of birth, sex, nationality status, and residential area.</td>
      <td class="examples">Date; M/F; Korean/foreign national; province/city/district</td>
    </tr>
<tr>
      <td><span class="domain-badge">Basic Information</span></td>
      <td class="subcategory">Clinical trial participation</td>
      <td>Participation in clinical trials.</td>
      <td>Participation status and number of clinical trial enrollments.</td>
      <td class="examples">Y/N; count</td>
    </tr>
<tr>
      <td><span class="domain-badge">Basic Information</span></td>
      <td class="subcategory">Cohort classification</td>
      <td>Predefined clinical/molecular cohort flags used for research-ready patient selection.</td>
      <td>EGFR-sensitive, ALK-positive, IO, rare-mutation, CNS metastasis and cohort-exclusion classifications.</td>
      <td class="examples">Cohort flags / predefined categories</td>
    </tr>
<tr>
      <td><span class="domain-badge">Basic Information</span></td>
      <td class="subcategory">Visit / follow-up</td>
      <td>Key hospital visit and follow-up dates.</td>
      <td>Last follow-up, first oncology visit/admission, physician ID and last visit type.</td>
      <td class="examples">YYYY-MM-DD; visit type; physician ID</td>
    </tr>
<tr>
      <td><span class="domain-badge">Basic Information</span></td>
      <td class="subcategory">Body measurements</td>
      <td>Integrated anthropometric measurements.</td>
      <td>Height, weight, BMI, measurement date and source.</td>
      <td class="examples">cm; kg; BMI; YYYY-MM-DD; source</td>
    </tr>
<tr>
      <td><span class="domain-badge">Follow-up &amp; Outcomes</span></td>
      <td class="subcategory">Vital status / death</td>
      <td>Vital status and mortality information from integrated clinical/registry sources.</td>
      <td>Death status/date, source of death date, cause-of-death code and cause descriptions.</td>
      <td class="examples">Y/N; YYYY-MM-DD; ICD/code; text/source</td>
    </tr>
<tr>
      <td><span class="domain-badge">Follow-up &amp; Outcomes</span></td>
      <td class="subcategory">Recurrence</td>
      <td>Post-treatment recurrence information.</td>
      <td>Recurrence status/date/source, including local and distant relapse.</td>
      <td class="examples">Initially/Recurred; Y/N; YYYY-MM-DD; source</td>
    </tr>
<tr>
      <td><span class="domain-badge">Follow-up &amp; Outcomes</span></td>
      <td class="subcategory">Metastasis</td>
      <td>Date, source and site-specific metastatic disease information.</td>
      <td>Overall metastatic date plus lung-to-lung, bone, liver, adrenal, pleural, nodal and other metastatic sites.</td>
      <td class="examples">Y/N; YYYY-MM-DD; site; source</td>
    </tr>
<tr>
      <td><span class="domain-badge">Follow-up &amp; Outcomes</span></td>
      <td class="subcategory">Brain metastasis</td>
      <td>Brain metastasis characteristics and treatment information.</td>
      <td>Brain metastasis status/date and CNS-directed treatment information.</td>
      <td class="examples">Y/N; YYYY-MM-DD; treatment category</td>
    </tr>
<tr>
      <td><span class="domain-badge">Follow-up &amp; Outcomes</span></td>
      <td class="subcategory">Survival outcomes</td>
      <td>Derived survival endpoints.</td>
      <td>Overall survival (OS), disease-free survival (DFS) and progression-free survival (PFS), including event/date/time variables.</td>
      <td class="examples">Event Y/N; date; survival time</td>
    </tr>
<tr>
      <td><span class="domain-badge">Medical History &amp; Status</span></td>
      <td class="subcategory">Smoking history</td>
      <td>Smoking exposure and status.</td>
      <td>Smoking status and quantitative smoking history.</td>
      <td class="examples">Never/former/current; pack-year related values</td>
    </tr>
<tr>
      <td><span class="domain-badge">Medical History &amp; Status</span></td>
      <td class="subcategory">Family history</td>
      <td>Cancer-related family history.</td>
      <td>Family history status and related information.</td>
      <td class="examples">Y/N / categorical</td>
    </tr>
<tr>
      <td><span class="domain-badge">Medical History &amp; Status</span></td>
      <td class="subcategory">Comorbidities</td>
      <td>Pre-existing medical conditions relevant to clinical characterization.</td>
      <td>Multiple comorbidity indicators derived from clinical information.</td>
      <td class="examples">Y/N / condition-specific indicators</td>
    </tr>
<tr>
      <td><span class="domain-badge">Medical History &amp; Status</span></td>
      <td class="subcategory">ECOG performance status</td>
      <td>Functional performance status.</td>
      <td>ECOG performance status and related timing information.</td>
      <td class="examples">ECOG 0–4; date</td>
    </tr>
<tr>
      <td><span class="domain-badge">Diagnosis</span></td>
      <td class="subcategory">Diagnosis dates</td>
      <td>Key dates defining cancer diagnosis.</td>
      <td>Initial diagnosis and institution-specific diagnosis dates.</td>
      <td class="examples">YYYY-MM-DD</td>
    </tr>
<tr>
      <td><span class="domain-badge">Diagnosis</span></td>
      <td class="subcategory">Primary diagnosis</td>
      <td>Primary cancer diagnosis information.</td>
      <td>Primary diagnosis name/code.</td>
      <td class="examples">Diagnosis code / text</td>
    </tr>
<tr>
      <td><span class="domain-badge">Diagnosis</span></td>
      <td class="subcategory">Histology</td>
      <td>Pathologic/histologic characterization of lung cancer.</td>
      <td>Histologic diagnosis and related pathologic classification variables.</td>
      <td class="examples">Histology category / text</td>
    </tr>
<tr>
      <td><span class="domain-badge">Diagnosis</span></td>
      <td class="subcategory">Clinical TNM stage</td>
      <td>Clinical TNM staging.</td>
      <td>Clinical T, N, M and overall stage across applicable AJCC editions.</td>
      <td class="examples">cT / cN / cM / Stage</td>
    </tr>
<tr>
      <td><span class="domain-badge">Diagnosis</span></td>
      <td class="subcategory">Pathologic TNM stage</td>
      <td>Pathologic TNM staging.</td>
      <td>Pathologic T, N, M and overall stage across applicable AJCC editions.</td>
      <td class="examples">pT / pN / pM / Stage</td>
    </tr>
<tr>
      <td><span class="domain-badge">Diagnosis</span></td>
      <td class="subcategory">Multiple primary cancer</td>
      <td>Information on synchronous/metachronous additional primary cancers.</td>
      <td>Presence and characteristics of additional primary malignancies.</td>
      <td class="examples">Y/N; site/diagnosis/date</td>
    </tr>
<tr>
      <td><span class="domain-badge">Examination</span></td>
      <td class="subcategory">EGFR</td>
      <td>EGFR molecular testing summarized at the gene level rather than by repeated result fields.</td>
      <td>Initial and repeat EGFR mutation results, detailed mutation information, EMR-derived results and cell-free testing. Initial/repeat; tissue and cell-free molecular results.</td>
      <td class="examples">Positive/negative/no mutation; mutation notation; date</td>
    </tr>
<tr>
      <td><span class="domain-badge">Examination</span></td>
      <td class="subcategory">ALK</td>
      <td>ALK testing summarized across available modalities.</td>
      <td>ALK IHC, FISH and EMR-derived ALK results. IHC; FISH; EMR-derived result.</td>
      <td class="examples">Positive/negative; score/result; date</td>
    </tr>
<tr>
      <td><span class="domain-badge">Examination</span></td>
      <td class="subcategory">PD-L1</td>
      <td>PD-L1 expression testing summarized across assay types.</td>
      <td>PD-L1 results from major IHC assays. 22C3; SP263; SP142; other assay.</td>
      <td class="examples">TPS/percentage or categorical result; date</td>
    </tr>
<tr>
      <td><span class="domain-badge">Examination</span></td>
      <td class="subcategory">NGS</td>
      <td>Next-generation sequencing information.</td>
      <td>NGS test availability and related test/result information. NGS.</td>
      <td class="examples">Panel/test information; date/result</td>
    </tr>
<tr>
      <td><span class="domain-badge">Examination</span></td>
      <td class="subcategory">ROS1</td>
      <td>ROS1 testing summarized across available modalities.</td>
      <td>ROS1 PCR and IHC results. PCR; IHC.</td>
      <td class="examples">Detected/not detected or positive/negative; date</td>
    </tr>
<tr>
      <td><span class="domain-badge">Examination</span></td>
      <td class="subcategory">BRAF</td>
      <td>BRAF molecular testing.</td>
      <td>BRAF mutation test result and related mutation information. Molecular mutation testing.</td>
      <td class="examples">Positive/negative; mutation notation; date</td>
    </tr>
<tr>
      <td><span class="domain-badge">Examination</span></td>
      <td class="subcategory">Bronchoscopy</td>
      <td>Bronchoscopic examination information.</td>
      <td>Bronchoscopy procedure, timing and related examination information. Bronchoscopy.</td>
      <td class="examples">Procedure/result/date</td>
    </tr>
<tr>
      <td><span class="domain-badge">Treatment</span></td>
      <td class="subcategory">Overall treatment sequence</td>
      <td>Longitudinal treatment history summarized as sequential treatment episodes.</td>
      <td>Treatment type, intent, timing and related treatment information across sequential treatment records. Up to 7 sequential treatment records plus last-treatment summary.</td>
      <td class="examples">Treatment type; date; intent; sequence</td>
    </tr>
<tr>
      <td><span class="domain-badge">Treatment</span></td>
      <td class="subcategory">Surgery</td>
      <td>Lung cancer surgical treatment history.</td>
      <td>Surgical information including procedure-related variables and repeated operations. Up to 3 surgery episodes.</td>
      <td class="examples">Procedure; date; surgical details</td>
    </tr>
<tr>
      <td><span class="domain-badge">Treatment</span></td>
      <td class="subcategory">Salvage treatment</td>
      <td>Salvage/local treatment after prior therapy.</td>
      <td>Salvage treatment type and related information. Salvage treatment.</td>
      <td class="examples">Treatment type / date</td>
    </tr>
<tr>
      <td><span class="domain-badge">Treatment</span></td>
      <td class="subcategory">Neoadjuvant systemic therapy</td>
      <td>Preoperative systemic treatment.</td>
      <td>Regimen and treatment-course information for neoadjuvant therapy. Up to 2 neoadjuvant treatment lines/courses.</td>
      <td class="examples">Regimen; start/end date; cycle/response-related fields</td>
    </tr>
<tr>
      <td><span class="domain-badge">Treatment</span></td>
      <td class="subcategory">Adjuvant systemic therapy</td>
      <td>Postoperative systemic treatment.</td>
      <td>Regimen and treatment-course information for adjuvant therapy. Up to 3 adjuvant treatment lines/courses.</td>
      <td class="examples">Regimen; start/end date; cycle/response-related fields</td>
    </tr>
<tr>
      <td><span class="domain-badge">Treatment</span></td>
      <td class="subcategory">Definitive therapy</td>
      <td>Definitive non-surgical treatment including systemic/chemoradiation-related treatment records.</td>
      <td>Regimen and treatment-course information for definitive therapy. Up to 3 definitive treatment lines/courses.</td>
      <td class="examples">Regimen; start/end date; treatment-related fields</td>
    </tr>
<tr>
      <td><span class="domain-badge">Treatment</span></td>
      <td class="subcategory">Durvalumab</td>
      <td>Consolidation durvalumab treatment information.</td>
      <td>Durvalumab treatment timing and related variables. Durvalumab.</td>
      <td class="examples">Treatment dates / treatment status</td>
    </tr>
<tr>
      <td><span class="domain-badge">Treatment</span></td>
      <td class="subcategory">Palliative systemic therapy</td>
      <td>Systemic therapy for recurrent/metastatic disease, consolidated rather than displayed line-by-line.</td>
      <td>Regimen, dates and treatment-course information for each palliative line. Up to 11 palliative lines (1L–11L).</td>
      <td class="examples">Line; regimen; start/end date; cycle/response-related fields</td>
    </tr>
<tr>
      <td><span class="domain-badge">Treatment</span></td>
      <td class="subcategory">Targeted / immunotherapy exposure</td>
      <td>Therapy-specific summary variables across treatment history.</td>
      <td>EGFR TKI, ALK TKI, PD-(L)1 inhibitor and other TKI exposure. EGFR TKI; ALK TKI; PD-(L)1 inhibitor; other TKI.</td>
      <td class="examples">Y/N; line(s); treatment information</td>
    </tr>
<tr>
      <td><span class="domain-badge">Treatment</span></td>
      <td class="subcategory">Sequential chemoradiotherapy</td>
      <td>Sequential chemotherapy/radiotherapy treatment information.</td>
      <td>Treatment sequence and related chemoradiotherapy variables. Sequential CRT.</td>
      <td class="examples">Treatment type; date; sequence</td>
    </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="registry-note">
        <strong>Registry note.</strong>
        Korea's national cancer registration program is coordinated through the Korea Central Cancer Registry (KCCR),
        a nationwide cancer registration program operated under the National Cancer Center.
        In this summary, “cancer registration year” refers to the year recorded for the cancer case in that registration framework.
      </div>

      <a href="data.html" class="back-link">
        <i class="bi bi-arrow-left"></i>
        Back to Data
      </a>

    </div>
  </section>
</main>
{% endblock %}
