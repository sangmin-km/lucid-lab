{% extends "_includes/base.njk" %}
{% block htmlOpen %}<html lang="ko">{% endblock %}
{% block head %}
<title>Projects | Research Lab</title>
<meta name="description" content="Ongoing and completed research projects">
<meta name="keywords" content="research projects, NSCLC, multimodal AI, RADAR CARE">
{% endblock %}
{% block styles %}
<link href="assets/css/pages/projects.css" rel="stylesheet">
{% endblock %}
{% block bodyOpen %}<body>{% endblock %}
{% block content %}
<main class="main">

  <section class="page-wrap">

    <div class="container">

      <h1 class="page-title">PROJECTS</h1>
      <hr class="title-line">

      {% include "_includes/project-list.njk" %}

      <section class="project-status-section" aria-labelledby="ai-voucher-heading">
        <h2 class="project-status-title" id="ai-voucher-heading">AI Voucher Program</h2>
        <h3 class="section-title-small">2024</h3>
        <div class="project-item">
          <button class="project-button" type="button" data-bs-toggle="collapse"
            data-bs-target="#ai-voucher-2024" aria-expanded="false" aria-controls="ai-voucher-2024">
            <span class="project-number">01</span>
            <span>
              <span class="project-type">AI Voucher Project · Completed</span>
              <span class="project-title d-block">Development and Multicenter Validation of a Multimodal Deep Learning Model for Lung Cancer Recurrence Prediction</span>
              <span class="project-subtitle d-block">AI Voucher Support Program</span>
              <span class="project-meta d-block">Samsung Medical Center · May – Nov 2024 · KRW 228.574 million</span>
            </span>
            <i class="bi bi-chevron-down project-icon" aria-hidden="true"></i>
          </button>
          <div class="collapse" id="ai-voucher-2024">
            <div class="project-detail">
              <div class="detail-grid">
                <div class="detail-label">Program</div>
                <div class="detail-value">AI Voucher Support Program</div>
                <div class="detail-label">Industry / Technology Classification</div>
                <div class="detail-value">Analytical Intelligence (분석지능)</div>
                <div class="detail-label">Lead Institution</div>
                <div class="detail-value">Samsung Medical Center</div>
                <div class="detail-label">Principal Investigator</div>
                <div class="detail-value">Hyun Ae Jung</div>
                <div class="detail-label">Project Period</div>
                <div class="detail-value">May 1, 2024 – November 30, 2024 (7 months)</div>
                <div class="detail-label">Government Funding</div>
                <div class="detail-value">KRW 160,000,000</div>
                <div class="detail-label">Private Contribution (In-kind)</div>
                <div class="detail-value">KRW 68,574,000</div>
                <div class="detail-label">Total Project Budget</div>
                <div class="detail-value">KRW 228,574,000</div>
                <div class="detail-label">Participating Institution</div>
                <div class="detail-value">Spidercore (주식회사 스파이더코어)</div>
                <div class="detail-label">Participating Institution Lead</div>
                <div class="detail-value">이기원 (기획부 / 대표이사)</div>
                <div class="detail-label">Working-level Lead</div>
                <div class="detail-value">이대환 (연구개발부 / 연구원)</div>
              </div>
            </div>
          </div>
        </div>
      </section>

    </div>

  </section>

</main>
{% endblock %}
