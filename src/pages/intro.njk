{% extends "_includes/base.njk" %}
{% block htmlOpen %}<html lang="ko">{% endblock %}
{% block head %}
<title>Introduce | LUCID</title>
<meta name="description" content="Research laboratory introduction">
<meta name="keywords" content="research, laboratory, healthcare, AI">
{% endblock %}
{% block styles %}
<link href="assets/css/pages/intro.css" rel="stylesheet">
{% endblock %}
{% block bodyOpen %}<body>{% endblock %}
{% block content %}
<main class="main">

    <section class="intro-page">

      <div class="container">

        <h1 class="intro-title">INTRODUCE</h1>
        <hr class="intro-title-line">

        <div class="row align-items-center gy-5">

          <div class="col-12 intro-content"
               data-aos="fade-up">

            <h2>About Our Lab</h2>

          <p>
            Our laboratory focuses on clinical data research and artificial intelligence
            to support diagnosis, prognosis prediction, and treatment decision-making in cancer care.
          </p>

          <p>
            We integrate diverse clinical information and multimodal medical data
            to develop data-driven research frameworks and AI models
            that can be translated into real-world clinical practice.
          </p>

          <p>
            By closely collaborating with clinicians and researchers,
            we aim to generate practical evidence and technologies
            that improve patient care and clinical outcomes.
          </p>
          </div>

<div class="intro-section">

  <h3 class="intro-section-title">
    Our Research Story
  </h3>

  <p class="mb-4" style="font-size:16px; line-height:1.8;">
    Cancer care is a continuous and non-linear journey.
    Our research follows patients across diagnosis, treatment,
    response assessment, recurrence or progression, supportive care,
    and long-term follow-up by integrating longitudinal,
    multimodal clinical and genomic data.
  </p>

  <div class="journey-wrapper" data-aos="fade-up">

    <img
      src="assets/img/cancer-journey.png"
      alt="Cancer journey and longitudinal multimodal data capture"
      class="journey-img"
    >

  </div>

</div>

        </div>

        <div class="intro-section">

          <h3 class="intro-section-title">Milestone</h3>

          <div class="milestone-wrapper"
               data-aos="fade-up"
               data-aos-delay="100">

            <div class="milestone-inner">

              <img
                src="assets/img/milestone.png"
                alt="ROOT HEALTH Research Milestone"
                class="milestone-img">

<a
  href="https://doi.org/10.1016/j.lungcan.2020.05.033"
